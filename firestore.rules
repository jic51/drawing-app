rules_version = '2';

/* Reglas de Firestore de SketchSend.
 *
 * Este archivo vive en el repo para poder razonarlo y versionarlo, pero
 * NO se aplica solo: hay que pegarlo en la consola (Firestore → Rules →
 * Publish) o desplegarlo con `firebase deploy --only firestore:rules`.
 *
 * Lo que cambia respecto a lo que hay publicado hoy está marcado con
 * CAMBIO. Lo demás se deja como estaba a propósito.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ── QUIÉN MANDA ─────────────────────────────────────────────────
       Tu uid, en UN solo sitio. Lo usan las denuncias y la cola de cosas
       sin aprobar.

       ⚠️ Cámbialo por el tuyo. No hace falta buscarlo: abre `admin.html`
       con tu cuenta y la propia página te lo enseña listo para copiar.
       Mientras siga el hueco de ejemplo, esas lecturas se deniegan —que es
       el lado seguro: lo público sigue siendo público y lo privado no se
       abre a nadie, ni siquiera a ti desde el navegador. */
    function ADMIN_UID() { return 'PON_AQUI_TU_UID'; }

    /* ── ¿ME BLOQUEÓ? ────────────────────────────────────────────────
       Se mira SU lista, que vive en su documento de usuario. `get()` dentro
       de una regla no pasa por las reglas de lectura, así que esto funciona
       aunque la lista no sea pública: nadie puede ver a quién has bloqueado,
       pero el servidor sí lo tiene en cuenta.

       Va declarada AQUÍ arriba, no dentro de un bloque, para que la vean
       tanto `sketches` como `friendships`.

       El `exists()` no sobra: si la cuenta del otro fue borrada, `get()`
       devuelve nulo y la regla reventaría. Reventar deniega, así que sin
       esto no se podría enviar a nadie cuyo documento haya desaparecido.

       Cuesta una o dos lecturas por envío. Con los números de hoy —301
       dibujos en total y 50.000 lecturas gratis al día— no se nota. */
    function meBloqueo(otro) {
      return request.auth != null
             && exists(/databases/$(database)/documents/users/$(otro))
             && (request.auth.uid in
                 get(/databases/$(database)/documents/users/$(otro))
                   .data.get('bloqueados', []));
    }

    /* ── USUARIOS ─────────────────────────────────────────────────────
       Leer exige sesión (ya lo cambiaste; antes era `if true` y cualquiera
       podía descargarse el correo de todo el mundo con una URL).
       Escribir, solo en el tuyo. */
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    /* ── AMISTADES ───────────────────────────────────────────────────
       CAMBIO COMPLETO. Antes: `allow read, write: if request.auth != null`,
       o sea que cualquiera con una cuenta podía leer las amistades de
       todos, inventar amistades entre terceros, ACEPTARSE a sí mismo una
       solicitud, y borrar las amistades de otros.

       Eso vaciaba de sentido todo lo de "las amistades se aceptan": si
       cualquiera puede escribir `accepted` en el documento, aceptar no
       protege de nada. */
    match /friendships/{docId} {

      function esMia()   { return request.auth != null && request.auth.uid in resource.data.users; }
      function seraMia() { return request.auth != null && request.auth.uid in request.resource.data.users; }

      /* Solo las tuyas. La app consulta con
         where('users','array-contains', miUid), que encaja con esto. */
      allow read: if esMia();

      /* Crear = PEDIR. Tienes que ser uno de los dos, tienes que figurar
         como quien lo pide, y nace pendiente. Así nadie puede inventar una
         amistad ya hecha, ni entre otras dos personas. */
      /* CAMBIO: tampoco puedes volver a AGREGAR a quien te bloqueó. Sin
         esto, bloquear solo servía hasta que el otro te pidiera amistad
         otra vez. */
      allow create: if seraMia()
                    && !meBloqueo(request.resource.data.users[0] == request.auth.uid
                                  ? request.resource.data.users[1]
                                  : request.resource.data.users[0])
                    && request.resource.data.users.size() == 2
                    && request.resource.data.users[0] != request.resource.data.users[1]
                    && request.resource.data.requestedBy == request.auth.uid
                    && request.resource.data.status == 'pendiente';

      /* Aceptar solo puede el DESTINATARIO, solo una vez, y solo puede
         cambiar el estado: ni las personas ni quién lo pidió. */
      allow update: if esMia()
                    && resource.data.status == 'pendiente'
                    && resource.data.requestedBy != request.auth.uid
                    && request.resource.data.status == 'accepted'
                    && request.resource.data.users == resource.data.users
                    && request.resource.data.requestedBy == resource.data.requestedBy;

      /* Borrar sirve para tres cosas: rechazar, retirar lo que pediste, y
         dejar de ser amigo. Las tres las puede hacer cualquiera de los dos. */
      allow delete: if esMia();
    }

    /* ── DIBUJOS ─────────────────────────────────────────────────────
       Sin cambios. El `get` abierto es a propósito y está bien pensado: el
       ID tiene 20 caracteres aleatorios y solo lo conoce quien recibió el
       enlace. Lo que no se puede es ENUMERAR la colección. */
    match /sketches/{sketchId} {
      allow get: if true;

      allow list: if request.auth != null
                  && (resource.data.to == request.auth.uid
                   || resource.data.from == request.auth.uid);

      /* CAMBIO: no puedes enviarle a quien te bloqueó. Esto SÍ es
         seguridad, no cosmética: el cliente también lo comprueba, pero el
         cliente se puede saltar. */
      allow create: if request.auth != null
                    && request.resource.data.from == request.auth.uid
                    && request.resource.size() < 900000
                    && !meBloqueo(request.resource.data.to);

      /* CAMBIO: el destinatario solo puede marcarlo como visto. Antes podía
         cambiar CUALQUIER campo, incluidos los trazos: podía reescribir el
         dibujo que le mandaron. */
      allow update: if request.auth != null
                    && resource.data.to == request.auth.uid
                    && request.resource.data.diff(resource.data)
                       .affectedKeys().hasOnly(['viewed', 'viewedAt']);

      allow delete: if request.auth != null
                    && (resource.data.from == request.auth.uid
                     || resource.data.to == request.auth.uid);
    }

    /* ── LO QUE ENVIASTE ─────────────────────────────────────────────
       Una copia pequeña de cada dibujo que mandas, con una miniatura de
       unos 7 KB. No se listan los `sketches` donde `from` eres tú porque
       los trazos viven dentro del mismo documento: diez dibujos enviados
       serían más de un mega bajado para enseñar diez cuadraditos.

       Solo tuyos, y solo tú los ves. El `viewed` lo pone el servidor
       cuando el otro lo abre, no el cliente: el id es el mismo que el del
       dibujo, así que la función lo encuentra sin buscar. */
    match /enviados/{id} {
      allow read: if request.auth != null && resource.data.de == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.de == request.auth.uid
                    && request.resource.size() < 60000;
      /* Nadie desde el navegador: lo escribe la función con permisos de
         administrador, que no pasa por aquí. */
      allow update: if false;
      allow delete: if request.auth != null && resource.data.de == request.auth.uid;
    }

    /* ── CONTADORES DE LA LANDING ────────────────────────────────────
       CAMBIO: antes cualquiera con cuenta podía escribir lo que quisiera y
       dejar el contador en lo que le apeteciera. Ahora solo se admiten
       incrementos de los campos conocidos. */
    match /stats/{doc} {
      allow read: if true;
      /* Solo se admiten estos campos y ninguno más, así que nadie puede
         meter basura. No impide poner un número cualquiera —eso en reglas
         es incómodo de verdad—, pero sí que el documento se llene de
         cosas raras, que era lo que estaba abierto de par en par. */
      allow write: if request.auth != null
                   && request.resource.data.keys().hasOnly(['sketchesSent', 'usuarios', 'zonas']);
    }

    /* ── GALERÍA Y OPINIONES ─────────────────────────────────────────
       CAMBIO: estaban declaradas DOS VECES cada una. Firestore une los
       bloques con OR, así que el segundo (`allow write: if false`) no
       protegía nada; solo despistaba. Queda una sola declaración.

       Nada se publica sin revisión: se crea con approved:false y solo tú
       lo cambias desde la consola. */
    match /landing_gallery/{doc} {
      /* CAMBIO (2026-11-18): solo lo APROBADO es público.

         Antes era `if true`, o sea que un dibujo subido a la galería era
         legible por cualquiera DESDE EL MOMENTO EN QUE SE SUBÍA, antes de
         que Jose lo revisara. Hoy no hay ninguno pendiente, así que no se
         filtró nada; pero el siguiente que alguien suba sí habría sido
         público mientras esperaba aprobación.

         Las dos consultas de la landing ya filtran por `approved == true`,
         así que esto no rompe nada. Y para revisar la cola está la consola
         de Firebase, o `admin.html` si pones tu uid abajo. */
      allow read: if resource.data.approved == true
                  || (request.auth != null && request.auth.uid == ADMIN_UID());
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.approved == false
                    && request.resource.size() < 900000;
      allow update, delete: if false;
    }

    match /landing_testimonials/{doc} {
      /* Mismo cambio que en la galería: una opinión sin aprobar no es
         pública. La landing ya consulta con `where('approved','==',true)`. */
      allow read: if resource.data.approved == true
                  || (request.auth != null && request.auth.uid == ADMIN_UID());
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.approved == false
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 280;

      /* CAMBIO: el autor puede REESCRIBIR la suya, y al hacerlo vuelve a
         quedar sin aprobar para que la revises otra vez.

         Antes `update` estaba en false, y la app sí tiene un camino para
         cambiar tu opinión (`previa.ref.set(datos)`): o sea que ese botón
         estaba roto y daba permiso denegado.

         Y de paso arregla lo de la foto: la foto se guarda AQUÍ en el
         momento de escribir, y la landing no puede ir a buscarla a `users`
         porque no tiene sesión. Quien escribió su opinión antes de ponerse
         foto salía con las iniciales para siempre; ahora le basta con
         volver a enviarla. */
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.approved == false
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 280;

      allow delete: if false;
    }

    /* ── DENUNCIAS ───────────────────────────────────────────────────
       CAMBIO: no estaban declaradas, así que se denegaba todo y la página
       de moderar no podía listarlas. Cualquiera con cuenta puede denunciar;
       leerlas, nadie desde el navegador salvo tú.

       ⚠️ Pon TU uid abajo (Firebase Console → Authentication → Users) o
       déjalo como está y sigue mirándolas desde la consola. */
    match /_reports/{doc} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && request.auth.uid == ADMIN_UID();
      allow update, delete: if false;
    }

    /* ── CORREOS DE LA LANDING ───────────────────────────────────────
       CAMBIO: antes permitía `update`, así que cualquiera podía sobrescribir
       la fila de un correo ajeno. Solo crear. La lista no se puede leer
       desde el navegador, así que no se puede cosechar. */
    match /landing_emails/{correo} {
      allow read: if false;
      /* `update` se queda permitido: la landing guarda con set(merge) y el
         correo es el ID del documento, así que apuntarse DOS VECES cuenta
         como actualización. Quitarlo rompía el segundo intento. Sobrescribir
         la fila de otro no da nada: solo contiene el mismo correo que ya es
         el nombre del documento. */
      allow create, update: if request.resource.data.email is string
                            && request.resource.data.email.size() < 200;
      allow delete: if false;
    }

    /* ── CONFIGURACIÓN ───────────────────────────────────────────────
       Hoy solo guarda `bienvenida`: el dibujo y el mensaje que recibe cada
       cuenta nueva. Lo escribe Jose desde Ajustes y lo lee la Cloud
       Function, que va con permisos de administrador y no pasa por aquí.

       Cerrado a todo el mundo salvo a él. Nadie más necesita leerlo: lo que
       llega a la bandeja es un `sketch` normal, creado por el servidor. */
    match /config/{doc} {
      allow read, write: if request.auth != null
                         && request.auth.uid == ADMIN_UID();
    }

    /* ── ERRORES ─────────────────────────────────────────────────────
       La app guarda aquí lo que se rompe en el navegador de la gente
       (`logRemoteError`). Esta colección NO estaba declarada en las reglas
       publicadas el 2026-11-16, así que desde ese día se deniega y los
       errores se pierden en silencio: justo lo contrario de lo que hace
       falta después de un cambio grande de reglas.

       Se puede escribir sin sesión a propósito: la mitad de los fallos
       interesantes pasan ANTES de entrar. Leer, nadie desde el navegador;
       se miran desde la consola de Firebase. */
    match /_errors/{doc} {
      allow create: if request.resource.data.keys()
                       .hasOnly(['uid','context','msg','stack','ua','createdAt','ts','url'])
                    && request.resource.size() < 20000;
      allow read, update, delete: if false;
    }

    /* ── FCM ─────────────────────────────────────────────────────────
       CAMBIO: la colección no se usa (los tokens viven en `users`) y estaba
       abierta a cualquiera con cuenta, que podía leer y SOBRESCRIBIR los de
       los demás y dejarlos sin avisos. Cerrada. */
    match /fcmTokens/{tokenId} {
      allow read, write: if false;
    }
  }
}
